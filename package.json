{
  "name": "welder-hero-video",
  "version": "0.1.0",
  "private": true,
  "description": "WELDER hero video \u2014 Neural-Symbolic AI for the Next Generation of Smart Manufacturing (Remotion)",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts WelderHero out/welder-hero.mp4 --crf=16 --pixel-format=yuv420p",
    "stills": "node scripts/render-stills.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "http-server demo -p 8093 -a 0.0.0.0 -c-1",
    "demo:build": "python3 scripts/build_demo.py --out demo/index.html --video welder-hero-1080p-web.mp4 --poster poster-720.jpg"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "4.0.520",
    "@remotion/fonts": "^4.0.520",
    "@remotion/transitions": "4.0.520",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "http-server": "^14.1.1",
    "typescript": "5.6.3"
  }
}
